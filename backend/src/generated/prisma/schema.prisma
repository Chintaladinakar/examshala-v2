generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id
  username          String?  @unique
  name              String
  email             String   @unique
  passwordHash      String?
  role              String   @default("student")
  isActive          Boolean  @default(true)
  status            String   @default("ACTIVE") // ACTIVE, INACTIVE, INVITED
  workspaceId       String?
  mode              String? // principal | teacher
  firstLogin        Boolean  @default(true)
  notificationPrefs Json?
  createdAt         DateTime @default(now())

  // Relations
  attempts        AssessmentAttempt[]
  student         Student?
  memberships     WorkspaceMembership[]
  studentLinks    ParentStudentLink[]       @relation("StudentRelation")
  parentLinks     ParentStudentLink[]       @relation("ParentRelation")
  studentProfiles StudentWorkspaceProfile[]

  // School SaaS SaaS Relations
  classTeachers         ClassTeacher[]
  classStudents         ClassStudent[]
  attendances           Attendance[]
  markedAttendances     Attendance[]              @relation("MarkedBy")
  updatedAttendances    Attendance[]              @relation("UpdatedBy")
  schoolAssignments     Assignment[]
  feedbacks             AssignmentFeedback[]
  submissions           AssignmentSubmission[]
  reviewedSubmissions   AssignmentSubmission[]    @relation("SubmissionReviewer")
  rubrics               Rubric[]
  materials             Material[]
  questions             Question[]
  exams                 Exam[]
  examAttempts          ExamAttempt[]
  conversationLinks     ConversationParticipant[]
  sentMessages          Message[]
  schoolLogs            SchoolLog[]
  results               Result[]
  teacherSubjects       TeacherSubject[]
  timetableSlots        TimetableSlot[]
  leaveRequests         LeaveRequest[]            @relation("LeaveRequester")
  reviewedLeaveRequests LeaveRequest[]            @relation("LeaveReviewer")
  calendarEvents        CalendarEvent[]
}

model OTP {
  id           String    @id @default(uuid())
  email        String    @unique
  code         String // 6-digit alphanumeric OTP
  type         String // "SIGNUP_VERIFICATION" | "PASSWORD_RESET"
  attemptCount Int       @default(0)
  blockedUntil DateTime? // When the email is blocked due to max attempts
  expiresAt    DateTime // When the OTP expires (5 minutes from generation)
  createdAt    DateTime  @default(now())
  verifiedAt   DateTime? // When OTP was successfully verified
}

model Workspace {
  id              String   @id
  name            String
  createdBy       String? // Org Admin ID
  principalId     String? // Principal ID
  status          String?  @default("ACTIVE")
  institutionType String?
  address         String?
  contactNumber   String?
  contactEmail    String?
  academicYear    String?
  term            String?
  semester        String?
  createdAt       DateTime @default(now())

  memberships     WorkspaceMembership[]
  studentProfiles StudentWorkspaceProfile[]
  assignments     AssessmentAssignment[]
  notifications   Notification[]
  classes         Class[]
  materials       Material[]
  questions       Question[]
  exams           Exam[]
  conversations   Conversation[]
  departments     Department[]
  subjects        Subject[]
  timetableSlots  TimetableSlot[]
  leaveRequests   LeaveRequest[]
  calendarEvents  CalendarEvent[]
}

model WorkspaceMembership {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        String   @default("student") // "student", "tutor", "admin"
  createdAt   DateTime @default(now())

  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model StudentWorkspaceProfile {
  id          String @id @default(uuid())
  userId      String
  workspaceId String
  metadata    Json?

  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Exam {
  id                String    @id @default(uuid())
  workspaceId       String
  classId           String
  createdByUserId   String
  title             String
  description       String?
  examType          String    @default("quiz") // quiz | class_test | unit_test | practice | mock | final
  subject           String?
  durationMinutes   Int
  passingPercentage Int?
  shuffleQuestions  Boolean   @default(false)
  shuffleOptions    Boolean   @default(false)
  status            String    @default("draft") // draft | published | archived
  reviewStatus      String    @default("approved") // pending | approved | rejected
  reviewNote        String?
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  Workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  CreatedBy     User           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]

  @@index([workspaceId])
  @@index([classId])
  @@index([status])
  @@index([reviewStatus])
}

model ExamQuestion {
  id            String @id @default(uuid())
  examId        String
  questionId    String
  order         Int    @default(0)
  marks         Int    @default(1)
  negativeMarks Float  @default(0)

  Exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  Question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
}

model ExamAttempt {
  id                   String    @id @default(uuid())
  examId               String
  studentId            String
  startedAt            DateTime  @default(now())
  submittedAt          DateTime?
  status               String    @default("in_progress") // in_progress | submitted | auto_submitted | evaluated
  score                Float?
  totalMarks           Int?
  percentage           Float?
  violationCount       Int       @default(0)
  timeRemainingSeconds Int?
  createdAt            DateTime  @default(now())

  Exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  Student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@unique([examId, studentId])
  @@index([status])
}

model ExamAnswer {
  id              String   @id @default(uuid())
  attemptId       String
  questionId      String
  selectedAnswer  Json?
  isCorrect       Boolean?
  marksAwarded    Float?
  markedForReview Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  Attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  Question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model Test {
  id           String   @id @default(uuid())
  title        String
  duration     Int
  instructions String?
  createdBy    String
  createdAt    DateTime @default(now())

  assignments AssessmentAssignment[]
}

model AssessmentAssignment {
  id               String   @id @default(uuid())
  testId           String
  workspaceId      String
  assignedByType   String // "tutor" | "parent" | "system"
  assignedByUserId String
  assignedByName   String
  assignedAt       DateTime @default(now())

  // Instructions specific to this assignment
  tutorInstructions String?

  scheduleWindowStart DateTime?
  scheduleWindowEnd   DateTime?

  isReady Boolean @default(true)

  Test      Test      @relation(fields: [testId], references: [id])
  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  attempts AssessmentAttempt[]
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  attempts AssessmentAttempt[]

  createdAt DateTime @default(now())
}

model Assessment {
  id         String @id @default(cuid())
  title      String
  subject    String
  totalMarks Int

  attempts AssessmentAttempt[]

  createdAt DateTime @default(now())
}

model AssessmentAttempt {
  id           String    @id @default(uuid())
  studentId    String
  assignmentId String?
  focusLoss    Int       @default(0)
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  status       String    @default("in_progress") // "in_progress" | "submitted" | "evaluated"

  User       User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Assignment AssessmentAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Result     AssessmentResult?

  // New Academic Results fields
  profileStudentId String?
  assessmentId     String?
  obtainedMarks    Int?
  totalMarks       Int?
  percentage       Float?
  rank             Int?

  student    Student?    @relation(fields: [profileStudentId], references: [id], onDelete: Cascade)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([profileStudentId])
  @@index([assessmentId])
  @@index([submittedAt])
  @@index([status])
}

model AssessmentResult {
  id          String   @id @default(uuid())
  attemptId   String   @unique
  score       Int
  maxScore    Int
  evaluatedAt DateTime @default(now())
  feedback    String?

  Attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String   @id @default(uuid())
  workspaceId   String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  Workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([workspaceId])
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?

  Conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  createdAt      DateTime @default(now())

  Conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  Sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String?
  type        String // "exam_assigned" | "result_published" | "system_alert" | "parent_request"
  title       String
  message     String
  isRead      Boolean  @default(false)
  actionUrl   String?
  createdAt   DateTime @default(now())

  Workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id              String    @id @default(uuid())
  workspaceId     String
  title           String
  description     String?
  eventType       String // holiday | meeting | ptm | workshop | sports | other
  startDate       DateTime
  endDate         DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  CreatedBy User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([startDate])
}

model ParentStudentLink {
  id                 String    @id @default(uuid())
  studentId          String
  parentUserId       String?
  pendingParentEmail String?
  relation           String // "father", "mother", "guardian"
  status             String    @default("pending") // "pending" | "active" | "removal_requested"
  requestedBy        String // "student" | "parent"
  linkedAt           DateTime?
  removalRequestedBy String?
  approvalMetadata   Json?

  Student User  @relation("StudentRelation", fields: [studentId], references: [id], onDelete: Cascade)
  Parent  User? @relation("ParentRelation", fields: [parentUserId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())
}

model Invite {
  id          String   @id @default(uuid())
  email       String
  role        String
  workspaceId String?
  status      String   @default("PENDING") // PENDING, ACCEPTED
  createdAt   DateTime @default(now())
}

model Log {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String // USER, WORKSPACE, INVITE, SYSTEM
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
}

model Class {
  id           String   @id @default(uuid())
  name         String
  workspaceId  String
  departmentId String?
  createdAt    DateTime @default(now())

  Workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teachers       ClassTeacher[]
  students       ClassStudent[]
  attendances    Attendance[]
  assignments    Assignment[]
  materials      Material[]
  exams          Exam[]
  timetableSlots TimetableSlot[]

  @@index([departmentId])
}

model Department {
  id          String   @id @default(uuid())
  name        String
  workspaceId String
  createdAt   DateTime @default(now())

  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  classes   Class[]
  subjects  Subject[]

  @@unique([workspaceId, name])
}

model Subject {
  id           String   @id @default(uuid())
  name         String
  code         String?
  workspaceId  String
  departmentId String?
  createdAt    DateTime @default(now())

  Workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Department     Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teachers       TeacherSubject[]
  timetableSlots TimetableSlot[]

  @@unique([workspaceId, name])
  @@index([departmentId])
}

model TeacherSubject {
  id        String   @id @default(uuid())
  teacherId String
  subjectId String
  createdAt DateTime @default(now())

  Teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  Subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([subjectId])
}

model ClassTeacher {
  id        String   @id @default(uuid())
  classId   String
  teacherId String
  createdAt DateTime @default(now())

  Class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  Teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
}

model ClassStudent {
  id        String   @id @default(uuid())
  classId   String
  studentId String
  createdAt DateTime @default(now())

  Class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  Student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
}

model Attendance {
  id             String   @id @default(uuid())
  classId        String
  studentId      String
  date           DateTime
  status         String // "present" | "absent"
  markedByUserId String
  lastUpdatedBy  String
  isLocked       Boolean  @default(false)
  createdAt      DateTime @default(now())

  Class     Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  Student   User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  MarkedBy  User  @relation("MarkedBy", fields: [markedByUserId], references: [id])
  UpdatedBy User  @relation("UpdatedBy", fields: [lastUpdatedBy], references: [id])

  @@unique([classId, studentId, date])
}

model Assignment {
  id              String   @id @default(uuid())
  title           String
  description     String
  dueDate         DateTime
  classId         String
  createdByUserId String
  createdRole     String // "teacher" | "principal-teacher-mode"
  createdAt       DateTime @default(now())

  // New fields
  subject     String?
  attachments String[] @default([])
  status      String?  @default("PENDING")
  marks       Int?
  teacherId   String?
  studentId   String?

  Class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  Creator     User                   @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  feedbacks   AssignmentFeedback[]
  submissions AssignmentSubmission[]
  rubric      Rubric?

  @@index([dueDate])
  @@index([subject])
  @@index([studentId])
}

model Rubric {
  id              String   @id @default(uuid())
  assignmentId    String   @unique
  title           String
  createdByUserId String
  createdAt       DateTime @default(now())

  Assignment Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  CreatedBy  User              @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  criteria   RubricCriterion[]
}

model RubricCriterion {
  id        String @id @default(uuid())
  rubricId  String
  title     String
  maxPoints Int
  order     Int    @default(0)

  Rubric Rubric        @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores RubricScore[]

  @@index([rubricId])
}

model RubricScore {
  id           String   @id @default(uuid())
  submissionId String
  criterionId  String
  points       Float
  comment      String?
  updatedAt    DateTime @updatedAt

  Submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  Criterion  RubricCriterion      @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterionId])
}

model AssignmentFeedback {
  id              String   @id @default(uuid())
  assignmentId    String
  comment         String
  createdByUserId String
  createdAt       DateTime @default(now())

  Assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Creator    User       @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
}

model AssignmentSubmission {
  id           String   @id @default(uuid())
  assignmentId String
  studentId    String
  fileUrl      String
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // New fields
  textSubmission String?
  uploadedFiles  String[] @default([])

  // Grading fields
  marksObtained    Int?
  status           String    @default("submitted") // "submitted" | "late" | "reviewed"
  feedbackComment  String?
  reviewedByUserId String?
  reviewedAt       DateTime?

  // Plagiarism-check integration point. No vendor is wired up yet; a future integration
  // (e.g. Turnitin/Copyleaks) would populate these fields via webhook or polling job.
  plagiarismStatus    String    @default("not_checked") // not_checked | pending | checked | flagged
  plagiarismScore     Float?
  plagiarismReportUrl String?
  plagiarismCheckedAt DateTime?

  Assignment   Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ReviewedBy   User?         @relation("SubmissionReviewer", fields: [reviewedByUserId], references: [id])
  rubricScores RubricScore[]

  @@index([studentId])
  @@index([assignmentId])
}

model Question {
  id              String   @id @default(uuid())
  workspaceId     String
  createdByUserId String
  type            String // mcq | true_false | short_answer | long_answer | coding | case_study | numerical | match | ordering
  difficulty      String   @default("medium") // easy | medium | hard | expert
  subject         String
  chapter         String?
  topic           String?
  learningOutcome String?
  bloomLevel      String?
  tags            String[] @default([])
  questionText    String
  options         Json? // for mcq / match / ordering
  correctAnswer   Json?
  explanation     String?
  version         Int      @default(1)
  isArchived      Boolean  @default(false)
  reviewStatus    String   @default("approved") // pending | approved | rejected
  reviewNote      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  Workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  CreatedBy     User           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  examQuestions ExamQuestion[]
  examAnswers   ExamAnswer[]

  @@index([workspaceId])
  @@index([subject])
  @@index([type])
  @@index([reviewStatus])
  @@index([difficulty])
}

model Material {
  id               String    @id @default(uuid())
  title            String
  type             String // PDF, DOC, PPT, LINK, NOTES
  fileUrl          String
  subject          String
  chapter          String?
  topic            String?
  workspaceId      String
  classId          String?
  uploadedByUserId String
  visibility       String    @default("published") // draft | scheduled | published | hidden
  scheduledAt      DateTime?
  viewCount        Int       @default(0)
  downloadCount    Int       @default(0)
  uploadDate       DateTime  @default(now())

  Workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Class      Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  UploadedBy User      @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([classId])
  @@index([subject])
}

model SchoolLog {
  id         String   @id @default(uuid())
  actionType String // "attendance_marked" | "attendance_updated" | "assignment_created" | "feedback_added"
  userId     String
  role       String
  entityId   String
  timestamp  DateTime @default(now())

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id               String    @id @default(uuid())
  workspaceId      String
  requesterId      String
  requesterRole    String // "student" | "teacher"
  startDate        DateTime
  endDate          DateTime
  reason           String
  status           String    @default("pending") // pending | approved | rejected
  reviewedByUserId String?
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  Workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Requester  User      @relation("LeaveRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  ReviewedBy User?     @relation("LeaveReviewer", fields: [reviewedByUserId], references: [id])

  @@index([workspaceId])
  @@index([requesterId])
  @@index([status])
}

model PlatformSettings {
  id           String   @id @default("global-settings")
  platformName String?
  supportEmail String?
  createdAt    DateTime @default(now())
}

model Result {
  id         String   @id @default(cuid())
  studentId  String
  examId     String
  subject    String
  score      Int
  totalMarks Int
  percentage Float
  grade      String
  rank       Int?
  status     String
  feedback   String?
  timeTaken  Int?
  createdAt  DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TimetableSlot {
  id              String   @id @default(uuid())
  workspaceId     String
  classId         String
  subjectId       String?
  teacherId       String?
  dayOfWeek       Int // 0 = Sunday .. 6 = Saturday
  startTime       String // "HH:mm"
  endTime         String // "HH:mm"
  room            String?
  meetingUrl      String?
  createdByUserId String
  createdAt       DateTime @default(now())

  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  Subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  Teacher   User?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, dayOfWeek, startTime])
  @@index([workspaceId])
  @@index([subjectId])
}
