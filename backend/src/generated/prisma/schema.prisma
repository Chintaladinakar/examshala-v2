generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id
  username     String?  @unique
  name         String
  email        String   @unique
  passwordHash String?
  role         String   @default("student")
  isActive     Boolean  @default(true)
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE, INVITED
  workspaceId  String?
  mode         String? // principal | teacher
  firstLogin   Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Relations
  attempts        AssessmentAttempt[]
  student         Student?
  memberships     WorkspaceMembership[]
  studentLinks    ParentStudentLink[]       @relation("StudentRelation")
  parentLinks     ParentStudentLink[]       @relation("ParentRelation")
  studentProfiles StudentWorkspaceProfile[]

  // School SaaS SaaS Relations
  classTeachers      ClassTeacher[]
  classStudents      ClassStudent[]
  attendances        Attendance[]
  markedAttendances  Attendance[]           @relation("MarkedBy")
  updatedAttendances Attendance[]           @relation("UpdatedBy")
  schoolAssignments  Assignment[]
  feedbacks          AssignmentFeedback[]
  submissions        AssignmentSubmission[]
  schoolLogs         SchoolLog[]
  results            Result[]
}

model OTP {
  id           String    @id @default(uuid())
  email        String    @unique
  code         String // 6-digit alphanumeric OTP
  type         String // "SIGNUP_VERIFICATION" | "PASSWORD_RESET"
  attemptCount Int       @default(0)
  blockedUntil DateTime? // When the email is blocked due to max attempts
  expiresAt    DateTime // When the OTP expires (5 minutes from generation)
  createdAt    DateTime  @default(now())
  verifiedAt   DateTime? // When OTP was successfully verified
}

model Workspace {
  id          String   @id
  name        String
  createdBy   String? // Org Admin ID
  principalId String? // Principal ID
  status      String?  @default("ACTIVE")
  createdAt   DateTime @default(now())

  memberships     WorkspaceMembership[]
  studentProfiles StudentWorkspaceProfile[]
  assignments     AssessmentAssignment[]
  notifications   Notification[]
  classes         Class[]
}

model WorkspaceMembership {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        String   @default("student") // "student", "tutor", "admin"
  createdAt   DateTime @default(now())

  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model StudentWorkspaceProfile {
  id          String @id @default(uuid())
  userId      String
  workspaceId String
  metadata    Json?

  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Test {
  id           String   @id @default(uuid())
  title        String
  duration     Int
  instructions String?
  createdBy    String
  createdAt    DateTime @default(now())

  assignments AssessmentAssignment[]
}

model AssessmentAssignment {
  id               String   @id @default(uuid())
  testId           String
  workspaceId      String
  assignedByType   String // "tutor" | "parent" | "system"
  assignedByUserId String
  assignedByName   String
  assignedAt       DateTime @default(now())

  // Instructions specific to this assignment
  tutorInstructions String?

  scheduleWindowStart DateTime?
  scheduleWindowEnd   DateTime?

  isReady Boolean @default(true)

  Test      Test      @relation(fields: [testId], references: [id])
  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  attempts AssessmentAttempt[]
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  attempts AssessmentAttempt[]

  createdAt DateTime @default(now())
}

model Assessment {
  id         String @id @default(cuid())
  title      String
  subject    String
  totalMarks Int

  attempts AssessmentAttempt[]

  createdAt DateTime @default(now())
}

model AssessmentAttempt {
  id           String    @id @default(uuid())
  studentId    String
  assignmentId String?
  focusLoss    Int       @default(0)
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  status       String    @default("in_progress") // "in_progress" | "submitted" | "evaluated"

  User       User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Assignment AssessmentAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Result     AssessmentResult?

  // New Academic Results fields
  profileStudentId String?
  assessmentId     String?
  obtainedMarks    Int?
  totalMarks       Int?
  percentage       Float?
  rank             Int?

  student    Student?    @relation(fields: [profileStudentId], references: [id], onDelete: Cascade)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([profileStudentId])
  @@index([assessmentId])
  @@index([submittedAt])
  @@index([status])
}

model AssessmentResult {
  id          String   @id @default(uuid())
  attemptId   String   @unique
  score       Int
  maxScore    Int
  evaluatedAt DateTime @default(now())
  feedback    String?

  Attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String?
  type        String // "exam_assigned" | "result_published" | "system_alert" | "parent_request"
  title       String
  message     String
  isRead      Boolean  @default(false)
  actionUrl   String?
  createdAt   DateTime @default(now())

  Workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ParentStudentLink {
  id                 String    @id @default(uuid())
  studentId          String
  parentUserId       String?
  pendingParentEmail String?
  relation           String // "father", "mother", "guardian"
  status             String    @default("pending") // "pending" | "active" | "removal_requested"
  requestedBy        String // "student" | "parent"
  linkedAt           DateTime?
  removalRequestedBy String?
  approvalMetadata   Json?

  Student User  @relation("StudentRelation", fields: [studentId], references: [id], onDelete: Cascade)
  Parent  User? @relation("ParentRelation", fields: [parentUserId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())
}

model Invite {
  id          String   @id @default(uuid())
  email       String
  role        String
  workspaceId String?
  status      String   @default("PENDING") // PENDING, ACCEPTED
  createdAt   DateTime @default(now())
}

model Log {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String // USER, WORKSPACE, INVITE, SYSTEM
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
}

model Class {
  id          String   @id @default(uuid())
  name        String
  workspaceId String
  createdAt   DateTime @default(now())

  Workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teachers    ClassTeacher[]
  students    ClassStudent[]
  attendances Attendance[]
  assignments Assignment[]
}

model ClassTeacher {
  id        String   @id @default(uuid())
  classId   String
  teacherId String
  createdAt DateTime @default(now())

  Class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  Teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
}

model ClassStudent {
  id        String   @id @default(uuid())
  classId   String
  studentId String
  createdAt DateTime @default(now())

  Class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  Student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
}

model Attendance {
  id             String   @id @default(uuid())
  classId        String
  studentId      String
  date           DateTime
  status         String // "present" | "absent"
  markedByUserId String
  lastUpdatedBy  String
  isLocked       Boolean  @default(false)
  createdAt      DateTime @default(now())

  Class     Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  Student   User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  MarkedBy  User  @relation("MarkedBy", fields: [markedByUserId], references: [id])
  UpdatedBy User  @relation("UpdatedBy", fields: [lastUpdatedBy], references: [id])

  @@unique([classId, studentId, date])
}

model Assignment {
  id              String   @id @default(uuid())
  title           String
  description     String
  dueDate         DateTime
  classId         String
  createdByUserId String
  createdRole     String // "teacher" | "principal-teacher-mode"
  createdAt       DateTime @default(now())

  // New fields
  subject     String?
  attachments String[] @default([])
  status      String?  @default("PENDING")
  marks       Int?
  teacherId   String?
  studentId   String?

  Class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  Creator     User                   @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  feedbacks   AssignmentFeedback[]
  submissions AssignmentSubmission[]

  @@index([dueDate])
  @@index([subject])
  @@index([studentId])
}

model AssignmentFeedback {
  id              String   @id @default(uuid())
  assignmentId    String
  comment         String
  createdByUserId String
  createdAt       DateTime @default(now())

  Assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Creator    User       @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
}

model AssignmentSubmission {
  id           String   @id @default(uuid())
  assignmentId String
  studentId    String
  fileUrl      String
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // New fields
  textSubmission String?
  uploadedFiles  String[] @default([])

  Assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([assignmentId])
}

model Material {
  id         String   @id @default(uuid())
  title      String
  type       String // PDF, DOC, PPT, LINK, NOTES
  fileUrl    String
  subject    String
  uploadedBy String
  uploadDate DateTime @default(now())

  @@index([subject])
}

model SchoolLog {
  id         String   @id @default(uuid())
  actionType String // "attendance_marked" | "attendance_updated" | "assignment_created" | "feedback_added"
  userId     String
  role       String
  entityId   String
  timestamp  DateTime @default(now())

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformSettings {
  id           String   @id @default("global-settings")
  platformName String?
  supportEmail String?
  createdAt    DateTime @default(now())
}

model Result {
  id         String   @id @default(cuid())
  studentId  String
  examId     String
  subject    String
  score      Int
  totalMarks Int
  percentage Float
  grade      String
  rank       Int?
  status     String
  feedback   String?
  timeTaken  Int?
  createdAt  DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
